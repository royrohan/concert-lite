# Which database the platform writes to: postgres | dynamo | spanner   (dsql = real Aurora DSQL, no container)
STORE_KIND=postgres
# Compose profiles: the database container for STORE_KIND (postgres | spanner; dynamo runs inside localstack),
# plus "apps" to also run coordinator, workers and trace UI as containers.
# scripts/up.sh <kind> sets both for you.
COMPOSE_PROFILES=postgres
