###Pure
// Shop domain used by the parser and resolver tests.
/* Block comments may span
   several lines. */

Profile shop::meta::Governance
{
  stereotypes: [reviewed, deprecated, restricted];
  tags: [owner, since, ticket];
}

Enum shop::domain::OrderStatus
{
  NEW,
  PAID,
  <<shop::meta::Governance.deprecated>> ON_HOLD,
  {shop::meta::Governance.since = '2024-03-01'} SHIPPED,
  CANCELLED,
}

Enum shop::domain::Currency { EUR, USD, GBP }

Class shop::domain::Auditable
{
  createdAt: DateTime[1];
  createdBy: String[0..1];
}

Class shop::domain::Party
{
  name: String[1];
  emails: String[*];
}

Class <<shop::meta::Governance.reviewed>> {shop::meta::Governance.owner = 'team-orders', shop::meta::Governance.since = '2024-01-15'} shop::domain::Customer extends shop::domain::Party, shop::domain::Auditable
[
  hasName: ($this.name->length() > 0),
  $this.emails->size() <= 5
]
{
  loyaltyPoints: Integer[1] = 0;
  vip: Boolean[1] = false;
}

Class shop::domain::Address
{
  street: String[1];
  city: String[1];
  postcode: String[0..1];
}

Class shop::domain::Order extends Auditable
[
  nonNegativeTotal: ($this.total >= 0.0),
  discountWithinTotal: ($this.discount->toOne() <= $this.total)
]
{
  orderId: String[1];
  status: OrderStatus[1] = shop::domain::OrderStatus.NEW;
  currency: Currency[1] = Currency.EUR;
  total: Float[1] = 100.0;
  discount: Decimal[0..1];
  itemCount: Integer[1] = 3;
  weight: Number[0..1] = 2;
  express: Boolean[1] = true;
  orderDate: StrictDate[1];
  placedAt: DateTime[0..1];
  deliveryDate: Date[0..1];
  labels: String[*] = ['new', 'web'];
  note: String[0..1] = 'It\'s fragile';
  temperature: Float[0..1] = -4.5;
  <<shop::meta::Governance.restricted>> {shop::meta::Governance.ticket = 'SEC-12'} internalRef: String[0..1];
  priorities: Integer[1..*] = [1, 2];
  couponCodes: String[0..3];
  trackingIds: String[2];
  ratings: Integer[2..*];
  (composite) shippingAddress: Address[1];
  (shared) billingAddress: Address[0..1];
  (none) giftNote: String[0..1];

  grandTotal() { $this.total - if($this.discount->isEmpty(), | 0.0, | $this.discount->toOne()) } : Float[1];
  label(prefix: String[1]) { $prefix + ' {' + $this.orderId + '}' } : String[1];
  lineSkus() { $this.lines->map(l | $l.sku)->filter(s | $s != '}') } : String[*];
}

Class shop::domain::OrderLine
{
  sku: String[1];
  quantity: Integer[1] = 1;
  unitPrice: Float[1];
}

Class shop::domain::Shipment
{
  carrier: String[1];
}

Class shop::domain::Product
{
  sku: String[1];
}

Class shop::domain::Category
{
  title: String[1];
}

// One-to-many: Order gets 'lines' (owned), OrderLine gets the 'order' back-reference.
Association shop::domain::OrderLines
{
  order: Order[1];
  lines: OrderLine[1..*];
}

// One-to-one: the composite end is owned even though it is end1.
Association shop::domain::OrderShipment
{
  (composite) shipment: Shipment[0..1];
  order: Order[1];
}

// Many-to-many: neither end is owned.
Association <<shop::meta::Governance.reviewed>> shop::domain::ProductCategories
{
  products: Product[*];
  categories: Category[*];
}

function shop::domain::orderValue(o: Order[1], withDiscount: Boolean[1]): Float[1]
{
  if($withDiscount, | $o.grandTotal(), | $o.total)
}
