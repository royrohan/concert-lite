###Pure
// A payment settled against two external systems: a ledger REST service (the charge) and a Kafka topic
// (payments.settled). SettlementMachine (smType settlement) calls both as Temporal activities from the settle transition, with
// idempotency keys, and undoes the charge with a Saga when the publish cannot be completed. The outcome
// comes back to the machine as a chained event (confirm / decline / fail). See showcases/payments/README.md.

Enum payments::PaymentStatus
{
  NEW, SETTLING, SETTLED, DECLINED, FAILED, CANCELLED
}

Class <<concert::sm.root>>
{
  concert::sm.type = 'settlement',
  concert::sm.initial = 'NEW',
  concert::sm.transitions = '
    NEW      -settle->  SETTLING  : SettlePayment;
    NEW      -cancel->  CANCELLED : CancelPayment;
    SETTLING -confirm-> SETTLED   : SettlementOutcome;
    SETTLING -decline-> DECLINED  : SettlementOutcome;
    SETTLING -fail->    FAILED    : SettlementOutcome',
  concert::sm.statusProperty = 'status',
  concert::sm.idProperty = 'paymentId'
}
payments::Payment
{
  paymentId: String[1];
  status: PaymentStatus[1] = PaymentStatus.NEW;
  accountId: String[0..1];
  amount: Decimal[0..1];
  currency: String[0..1];
  memo: String[0..1];
  // the ledger's charge: its reference, and the activity attempt that got the answer (1 = no retry)
  ledgerRef: String[0..1];
  ledgerAttempts: Integer[1] = 0;
  ledgerReplayed: Boolean[0..1];
  // the Kafka record of the settlement and the attempt that got its ack
  kafkaPartition: Integer[0..1];
  kafkaOffset: Integer[0..1];
  kafkaAttempts: Integer[1] = 0;
  // why it was declined or failed, and whether the charge was refunded (Saga compensation)
  reason: String[0..1];
  refunded: Boolean[1] = false;
  settledAt: DateTime[0..1];
}

Class <<concert::sm.command>> payments::SettlePayment
{
  accountId: String[1];
  amount: Decimal[1];
  currency: String[1];
  memo: String[0..1];
}

Class <<concert::sm.command>> payments::CancelPayment
{
  reason: String[1];
}

// What the settle transition found out, sent back to the machine as the confirm / decline / fail event.
Class <<concert::sm.command>> payments::SettlementOutcome
{
  ledgerRef: String[0..1];
  ledgerAttempts: Integer[0..1];
  ledgerReplayed: Boolean[0..1];
  kafkaPartition: Integer[0..1];
  kafkaOffset: Integer[0..1];
  kafkaAttempts: Integer[0..1];
  reason: String[0..1];
  refunded: Boolean[0..1];
}
