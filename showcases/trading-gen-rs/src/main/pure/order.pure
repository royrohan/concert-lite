###Pure
// Copy of core/trading-model/src/main/pure/order.pure with the trading state machines declared in Pure
// (concert::sm), equivalent to the hand-written TradingFlows (showcases/trading). The same machines as
// examples/trading-gen, run on the Rust coordinator: showcases/trading-gen-rs
// (./generate-concert-ecosystem examples/trading-gen-rs --name trading-gen-rs --coordinator rust). The smTypes are
// prefixed rs_ so they never clash with trading-gen (gen_) or the hand-written machines; lock namespaces follow them.
// Trading aggregates. Each is the data of one state machine type (see TradingFlows):
//   Order      trading_order      parent client order; owns copies of its executions and allocations
//   Execution  trading_execution  child order routed to one venue; owns copies of its fills
//   Fill       trading_fill       one venue fill; BOOKED (terminal) on its first event
//   Allocation trading_allocation part of a filled order given to an account
//   Trade      rs_trading_system the trading system: one trade's entry point, chaining the machines below
//
// Event chaining (concert::sm.emits): the trading system's submit drives the order; then each machine's terminal state
// starts the next one, and reports back to the trading system:
//   trade SUBMITTED -> order (submit, ack, route, complete_fill, allocate, close)
//   order FILLED -> execution (route, complete_fill)    execution FILLED -> fill (book)    fill BOOKED -> allocation
//   (allocate, confirm)    allocation CONFIRMED -> trade COMPLETE;  order REJECTED | CANCELLED -> trade FAILED
// The owned to-many ends (Order.executions, Execution.fills, Order.allocations) are the serialized
// side, so an Order snapshot carries its full execution and fill tree for analytics. The back
// references are [0..1] because Execution, Fill and Allocation are also aggregate roots of their own
// machines, where the parent is not loaded.
import trading::common::*;

Enum trading::order::OrderStatus
{
  PENDING_NEW, NEW, ACKED, WORKING, PARTIALLY_FILLED, ALLOCATING, CANCEL_ALLOCATING, FILLED, CANCELLED, REJECTED
}

Enum trading::order::ExecutionStatus
{
  PENDING_NEW, ROUTED, PARTIALLY_FILLED, FILLED, CANCELLED, REJECTED
}

Enum trading::order::FillStatus
{
  PENDING, BOOKED
}

Enum trading::order::AllocationStatus
{
  PENDING, ALLOCATED, CONFIRMED
}

Enum trading::order::TradeStatus
{
  PENDING, SUBMITTED, ORDER_DONE, EXECUTED, FILLED, COMPLETE, FAILED
}

Class <<concert::sm.root>>
{
  concert::sm.type = 'rs_trading_system',
  concert::sm.initial = 'PENDING',
  concert::sm.transitions = '
    PENDING    -submit->          SUBMITTED  : SubmitTradeCommand;
    SUBMITTED  -order_done->      ORDER_DONE : ChainStepCommand;
    SUBMITTED  -order_failed->    FAILED     : ChainStepCommand;
    ORDER_DONE -execution_done->  EXECUTED   : ChainStepCommand;
    EXECUTED   -fill_done->       FILLED     : ChainStepCommand;
    FILLED     -allocation_done-> COMPLETE   : ChainStepCommand',
  // one trade per order: the instance key is the order id, which the whole chain carries
  concert::sm.idProperty = 'orderId',
  concert::sm.emits = '
    SUBMITTED -> rs_trading_order.submit [{orderId}] (arrivalPx = {price});
    SUBMITTED -> rs_trading_order.ack [{orderId}];
    SUBMITTED -> rs_trading_order.route [{orderId}] (execId = {orderId}-E1);
    SUBMITTED -> rs_trading_order.complete_fill [{orderId}] (fillId = {orderId}-F1, execId = {orderId}-E1);
    SUBMITTED -> rs_trading_order.allocate [{orderId}] (allocId = {orderId}-A1, avgPx = {price});
    SUBMITTED -> rs_trading_order.close [{orderId}] (allocatedQty = {quantity}, allocationCount = 1)'
}
trading::order::Trade
{
  orderId: String[1];
  accountId: String[1];
  clientId: String[1];
  symbol: String[1];
  side: Side[1];
  orderType: OrderType[1] = OrderType.MARKET;
  quantity: Integer[1];
  limitPrice: Decimal[0..1];
  venue: String[1];
  price: Decimal[1];
  fee: Decimal[1] = 0.0D;
  liquidity: Liquidity[1] = Liquidity.REMOVE;
  allocAccountId: String[1];
  status: TradeStatus[1] = TradeStatus.PENDING;
  // The last step reported by the chain, and the ids of the entities it created.
  step: String[0..1];
  refId: String[0..1];
  state: String[0..1];
  submittedAt: DateTime[0..1];
  completedAt: DateTime[0..1];
}

Class <<concert::sm.root>>
{
  concert::sm.type = 'rs_trading_order',
  concert::sm.initial = 'PENDING_NEW',
  concert::sm.transitions = '
    PENDING_NEW       -submit->        NEW               : NewOrderCommand;
    NEW               -ack->           ACKED             : AckCommand;
    NEW               -reject->        REJECTED          : RejectCommand;
    ACKED             -route->         WORKING           : RouteCommand;
    ACKED             -cancel->        CANCELLED         : CancelCommand;
    WORKING           -route->         WORKING           : RouteCommand;
    WORKING           -fill->          PARTIALLY_FILLED  : FillCommand;
    WORKING           -complete_fill-> ALLOCATING        : FillCommand;
    WORKING           -cancel->        CANCELLED         : CancelCommand;
    PARTIALLY_FILLED  -route->         PARTIALLY_FILLED  : RouteCommand;
    PARTIALLY_FILLED  -fill->          PARTIALLY_FILLED  : FillCommand;
    PARTIALLY_FILLED  -complete_fill-> ALLOCATING        : FillCommand;
    PARTIALLY_FILLED  -cancel->        CANCEL_ALLOCATING : CancelCommand;
    ALLOCATING        -allocate->      ALLOCATING        : AllocateCommand;
    ALLOCATING        -close->         FILLED            : CloseOrderCommand;
    CANCEL_ALLOCATING -allocate->      CANCEL_ALLOCATING : AllocateCommand;
    CANCEL_ALLOCATING -close->         CANCELLED         : CloseOrderCommand',
  concert::sm.locks = '*: account:{accountId}',
  concert::sm.idProperty = 'orderId',
  concert::sm.emits = '
    FILLED -> rs_trading_system.order_done [{orderId}] (step = order, refId = {orderId}, state = {status});
    REJECTED | CANCELLED -> rs_trading_system.order_failed [{orderId}] (step = order, refId = {orderId}, state = {status});
    FILLED -> rs_trading_execution.route [{orderId}-E1] (execId = {orderId}-E1, venue = XNYS);
    FILLED -> rs_trading_execution.complete_fill [{orderId}-E1]
      (execId = {orderId}-E1, fillId = {orderId}-F1, venue = XNYS, price = {arrivalPx}, liquidity = REMOVE, fee = 0)'
}
trading::order::Order
[
  // Documentation only (constraints are not executed); the order machine enforces them.
  filledWithinQuantity: $this.filledQty <= $this.quantity,
  allocatedWithinFilled: $this.allocatedQty <= $this.filledQty
]
{
  orderId: String[1];
  clientId: String[1];
  // Parent account: credit is checked and consumed against it (lock key account:<accountId>).
  accountId: String[1];
  symbol: String[1];
  side: Side[1];
  orderType: OrderType[1] = OrderType.MARKET;
  limitPrice: Decimal[0..1];
  timeInForce: TimeInForce[1] = TimeInForce.DAY;
  currency: Currency[1] = Currency.USD;
  quantity: Integer[1];
  filledQty: Integer[1] = 0;
  leavesQty: Integer[1] = 0;
  routedQty: Integer[1] = 0;
  allocatedQty: Integer[1] = 0;
  avgPx: Decimal[0..1];
  // Mid at order arrival: the benchmark for implementation shortfall.
  arrivalPx: Decimal[0..1];
  notional: Decimal[1] = 0.0D;
  totalFees: Decimal[1] = 0.0D;
  status: OrderStatus[1] = OrderStatus.PENDING_NEW;
  rejectReason: String[0..1];
  cancelReason: String[0..1];
  createdAt: DateTime[0..1];
  ackedAt: DateTime[0..1];
  firstFillAt: DateTime[0..1];
  lastFillAt: DateTime[0..1];
  completedAt: DateTime[0..1];

  fillRatio() { $this.filledQty / $this.quantity } : Float[1];
}

Class <<concert::sm.root>>
{
  concert::sm.type = 'rs_trading_execution',
  concert::sm.initial = 'PENDING_NEW',
  concert::sm.transitions = '
    PENDING_NEW      -route->         ROUTED           : RouteCommand;
    ROUTED           -fill->          PARTIALLY_FILLED : FillCommand;
    ROUTED           -complete_fill-> FILLED           : FillCommand;
    ROUTED           -cancel->        CANCELLED        : CancelCommand;
    ROUTED           -reject->        REJECTED         : RejectCommand;
    PARTIALLY_FILLED -fill->          PARTIALLY_FILLED : FillCommand;
    PARTIALLY_FILLED -complete_fill-> FILLED           : FillCommand;
    PARTIALLY_FILLED -cancel->        CANCELLED        : CancelCommand',
  concert::sm.locks = '*: rs_trading_order:{orderId}',
  concert::sm.idProperty = 'execId',
  concert::sm.emits = '
    FILLED -> rs_trading_system.execution_done [{orderId}] (step = execution, refId = {execId}, state = {status});
    FILLED -> rs_trading_fill.book [{fillId}]'
}
trading::order::Execution
{
  execId: String[1];
  orderId: String[1];
  symbol: String[1];
  side: Side[1];
  venue: String[1];
  quantity: Integer[1];
  filledQty: Integer[1] = 0;
  limitPrice: Decimal[0..1];
  avgPx: Decimal[0..1];
  totalFees: Decimal[1] = 0.0D;
  status: ExecutionStatus[1] = ExecutionStatus.PENDING_NEW;
  routedAt: DateTime[0..1];
  completedAt: DateTime[0..1];
}

Class <<concert::sm.root>>
{
  concert::sm.type = 'rs_trading_fill',
  concert::sm.initial = 'PENDING',
  concert::sm.transitions = 'PENDING -book-> BOOKED : FillCommand',
  concert::sm.locks = '*: rs_trading_order:{orderId}, rs_trading_execution:{execId}',
  concert::sm.idProperty = 'fillId',
  concert::sm.emits = '
    BOOKED -> rs_trading_system.fill_done [{orderId}] (step = fill, refId = {fillId}, state = {status});
    BOOKED -> rs_trading_allocation.allocate [{orderId}-A1] (allocId = {orderId}-A1, allocAccountId = {accountId}, avgPx = {price});
    BOOKED -> rs_trading_allocation.confirm [{orderId}-A1] (allocId = {orderId}-A1, allocAccountId = {accountId})'
}
trading::order::Fill
{
  fillId: String[1];
  execId: String[1];
  orderId: String[1];
  accountId: String[1];
  symbol: String[1];
  side: Side[1];
  quantity: Integer[1];
  price: Decimal[1];
  venue: String[1];
  liquidity: Liquidity[1];
  // Venue fee for this fill; negative = rebate.
  fee: Decimal[1];
  status: FillStatus[1] = FillStatus.PENDING;
  ts: DateTime[1];
}

Class <<concert::sm.root>>
{
  concert::sm.type = 'rs_trading_allocation',
  concert::sm.initial = 'PENDING',
  concert::sm.transitions = '
    PENDING   -allocate-> ALLOCATED : AllocateCommand;
    ALLOCATED -confirm->  CONFIRMED : ConfirmAllocationCommand',
  concert::sm.locks = '*: rs_trading_order:{orderId}, account:{allocAccountId}',
  concert::sm.idProperty = 'allocId',
  concert::sm.emits = '
    CONFIRMED -> rs_trading_system.allocation_done [{orderId}] (step = allocation, refId = {allocId}, state = {status})'
}
trading::order::Allocation
{
  allocId: String[1];
  orderId: String[1];
  // The account receiving the shares (may differ from the order's parent account).
  accountId: String[1];
  symbol: String[1];
  side: Side[1];
  quantity: Integer[1];
  avgPx: Decimal[1];
  status: AllocationStatus[1] = AllocationStatus.PENDING;
  allocatedAt: DateTime[0..1];
  confirmedAt: DateTime[0..1];
}

Association trading::order::OrderExecutions
{
  order: Order[0..1];
  executions: Execution[*];
}

Association trading::order::ExecutionFills
{
  execution: Execution[0..1];
  fills: Fill[*];
}

Association trading::order::OrderAllocations
{
  order: Order[0..1];
  allocations: Allocation[*];
}
