<!-- Local-dev ClickHouse: small memory footprint, quiet logs, no heavy system log tables. -->
<clickhouse>
    <max_server_memory_usage>1610612736</max_server_memory_usage>   <!-- 1.5 GiB (container limit 2 GiB) -->
    <mark_cache_size>134217728</mark_cache_size>                   <!-- 128 MiB (default 5 GiB) -->
    <uncompressed_cache_size>67108864</uncompressed_cache_size>
    <index_mark_cache_size>33554432</index_mark_cache_size>
    <index_uncompressed_cache_size>33554432</index_uncompressed_cache_size>
    <primary_index_cache_size>67108864</primary_index_cache_size>
    <query_condition_cache_size>16777216</query_condition_cache_size>
    <query_cache>
        <max_size_in_bytes>67108864</max_size_in_bytes>
    </query_cache>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <!-- System logs we don't need locally (query_log stays: it is handy in the Play UI). -->
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <processors_profile_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <latency_log remove="1"/>
    <error_log remove="1"/>
    <query_metric_log remove="1"/>
    <!-- librdkafka buffers per Kafka-engine consumer: 64 MiB by default, 6 queues here. -->
    <kafka>
        <queued_max_messages_kbytes>16384</queued_max_messages_kbytes>
    </kafka>
</clickhouse>
